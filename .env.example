# Puerto de exposición en local / Docker
PORT=3000
NODE_ENV=production

# Configuración opcional de ingesta histórica de X/Twitter (`npm run ingesta:tweets`)
# Sin credenciales, coloca exportaciones (.json, tweets.js, .csv) en `pipeline/imports/`
# o hidrata URLs puntuales vía `--url https://x.com/joseantoniokast/status/...`
# X_TARGET_USER=joseantoniokast
# X_BEARER_TOKEN=
# SOCIALDATA_API_KEY=

# Intervalo en minutos para `npm run worker:watch` (por defecto 30)
# WORKER_INTERVAL_MINUTES=30

# Configuración opcional de verificación semántica LLM para `npm run worker`
# Si se omiten, el motor funciona 100% determinista sin consumir APIs externas
# OPENAI_API_KEY=sk-...
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=gpt-4o-mini
